# OS
.DS_Store
Thumbs.db

# Editor
.idea/
*.swp
*.swo

# --- work/ project repositories (process v50) ---
# Each work/<project>/ is its OWN independent git repository so a project can be
# lifted out and exist standalone. The parent repo (agent structure + process)
# does not track project output; project changes are committed inside the project
# repo via `git -C work/<project> ...`. Future projects are auto-ignored here.
# Kept in THIS repo (agent-system state, not project output): work/README.md
# (project index), work/_TEMPLATE/ (the /project-new scaffold), work/ACTIVE.example.
/work/*/
!/work/_TEMPLATE/

# work/ACTIVE is MACHINE-LOCAL (multi-instance operating model): each Claude
# instance owns its own active-project pointer and must never commit it, so two
# machines working different projects don't flip each other's ACTIVE. The tracked
# seed is work/ACTIVE.example; `/project-switch` writes the local work/ACTIVE.
/work/ACTIVE

# python bytecode from dora.py / tests
__pycache__/
*.pyc

# Global derived DORA read-models — GITIGNORED + regenerated per-machine (process §0a
# Rule 4, human-approved 2026-07-05). Both instances regenerating+committing these made
# them conflict on every cross-instance reconcile; they are pure functions of the ledger
# (the SSOT), so each machine rebuilds them locally with `make dora-compute`.
/process/dora/baseline.md
/process/dora/statusline.json

node_modules

# Machine-local Claude Code config — per-tree, never committed.
# While tracked, every worktree edit leaves the integration tree dirty and
# defers EVERY project fold-back (blocked 2 instances: OagEventSource v123, AdixOut v121).
.claude/settings.local.json

# Agent-tool isolation worktrees — machine-local, disposable scaffolding, never committed.
# Left untracked they still dirty the INTEGRATION tree and defer every fold-back
# (blocked OagEventSource v124). Nothing here is tracked today, so ignoring deletes
# nothing in any worktree (contrast the settings.local.json untracking, which does).
# NOTE (v124/DEFECT-OAG-045): a project repo is a gitignored NESTED clone, invisible to
# the auto-clean's changed-check — never let a committing agent's only copy live here.
.claude/worktrees/

# board-sweep resume + lock files (DEFECT-OAG-099) — MACHINE-LOCAL run state, not
# process. The resume list names the ids a rate limit cut off; the lock stops two
# concurrent sweeps double-spending one rate budget. Both are per-tree and
# regenerated on every run, and committing them would dirty the integration tree
# and defer every fold-back.
.claude/state/
