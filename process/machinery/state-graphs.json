{
  "_comment": "Declarative per-item-type state machines. THE auditable core of the event-sourced work-item model (Version2-design/04). An item's current state is fold(events) through its type's graph. Appending an event that is not a legal transition from the current state is REJECTED at write time — a half-transition (the drift class) becomes unrepresentable. Wanting a transition that does not exist here is not something an agent may just do: it must propose an amendment to this file WITH A REASON — a process experiment (EXP-NNN) routed through the retro/version-bump gate. Edit this file only via that gate.",
  "version": 2,
  "state_owners": {
    "_comment": "Who is accountable for the time an item spends in each state — the basis for attributing GROSS LEAD TIME. An agent name = that agent is actively working the item (their throughput/quality). 'queue' = pure wait latency, nobody working (a flow/constraint cost, the classic time thief). 'external' = blocked on something outside the system (human gate, third-party portal) — excluded from any agent's quality but counted in gross lead time. Every part of the process reads its own contribution from here.",
    "registered": "queue",
    "ready": "queue",
    "building": "engineer",
    "validating": "tester",
    "reworking": "engineer",
    "blocked": "external",
    "reported": "orchestrator",
    "reproducing": "engineer",
    "fixing": "engineer",
    "open": "queue",
    "scheduled": "queue"
  },
  "queue_map": {
    "_comment": "state -> the derived queue an item appears in. Queues are a VIEW computed from state, never stored. 'wip' = pulled and in flight (not pullable). null = in no queue (terminal or aggregate).",
    "registered": "intake",
    "ready": "ready",
    "building": "wip",
    "validating": "wip",
    "reworking": "rework",
    "blocked": "waiting",
    "reported": "intake",
    "reproducing": "wip",
    "fixing": "wip",
    "open": "intake",
    "scheduled": "ready",
    "planned": null,
    "in_progress": null,
    "done": null,
    "resolved": null,
    "wontfix": null
  },
  "types": {
    "use-case": {
      "kind": "flow",
      "initial": "registered",
      "terminal": ["done"],
      "transitions": [
        {"from": "registered",  "to": "ready",       "event": "made_ready",   "agents": ["flow-manager"]},
        {"from": "ready",       "to": "building",     "event": "pulled",       "agents": ["orchestrator", "flow-manager"]},
        {"from": "building",    "to": "validating",   "event": "built_green",  "agents": ["engineer"]},
        {"from": "building",    "to": "reworking",    "event": "build_failed", "agents": ["engineer", "cicd"]},
        {"from": "validating",  "to": "done",         "event": "validated",    "agents": ["tester"]},
        {"from": "validating",  "to": "reworking",    "event": "rejected",     "agents": ["tester"]},
        {"from": "reworking",   "to": "building",     "event": "retried",      "agents": ["engineer"]},
        {"from": "ready",       "to": "blocked",      "event": "blocked",      "agents": ["flow-manager", "orchestrator"]},
        {"from": "building",    "to": "blocked",      "event": "blocked",      "agents": ["flow-manager", "orchestrator"]},
        {"from": "validating",  "to": "blocked",      "event": "blocked",      "agents": ["flow-manager", "orchestrator"]},
        {"from": "blocked",     "to": "ready",        "event": "unblocked",    "agents": ["flow-manager"]},
        {"from": "done",        "to": "building",     "event": "reopened",     "agents": ["orchestrator"]}
      ]
    },
    "defect": {
      "kind": "flow",
      "initial": "reported",
      "terminal": ["resolved", "wontfix"],
      "transitions": [
        {"from": "reported",    "to": "reproducing", "event": "triaged",       "agents": ["orchestrator"]},
        {"from": "reproducing", "to": "fixing",      "event": "confirmed",     "agents": ["orchestrator", "engineer"]},
        {"from": "reproducing", "to": "wontfix",     "event": "not_reproduced","agents": ["orchestrator"]},
        {"from": "fixing",      "to": "validating",  "event": "fixed",         "agents": ["engineer"]},
        {"from": "validating",  "to": "resolved",    "event": "validated",     "agents": ["tester"]},
        {"from": "validating",  "to": "fixing",      "event": "rejected",      "agents": ["tester"]},
        {"from": "fixing",      "to": "blocked",     "event": "blocked",       "agents": ["flow-manager", "orchestrator"]},
        {"from": "reproducing", "to": "blocked",     "event": "blocked",       "agents": ["flow-manager", "orchestrator"]},
        {"from": "blocked",     "to": "fixing",      "event": "unblocked",     "agents": ["flow-manager"]}
      ]
    },
    "open-item": {
      "kind": "flow",
      "initial": "open",
      "terminal": ["done", "wontfix"],
      "transitions": [
        {"from": "open",      "to": "scheduled", "event": "scheduled", "agents": ["flow-manager", "orchestrator"]},
        {"from": "scheduled", "to": "done",      "event": "closed",    "agents": ["orchestrator", "engineer", "tester"]},
        {"from": "open",      "to": "done",      "event": "closed",    "agents": ["orchestrator", "engineer", "tester"]},
        {"from": "open",      "to": "wontfix",   "event": "declined",  "agents": ["orchestrator"]}
      ]
    },
    "slice": {
      "kind": "aggregate",
      "initial": "planned",
      "terminal": ["done"],
      "bubble": "done_when_all_children_done",
      "_comment": "Aggregate state is DERIVED from children: done iff all children done; in_progress iff any child past its initial state; else planned. Aggregates carry registered/amended events for audit but their state is a fold over children, not their own event stream."
    },
    "chunk": {
      "kind": "aggregate",
      "initial": "planned",
      "terminal": ["done"],
      "bubble": "done_when_all_children_done"
    },
    "requirement": {
      "kind": "aggregate",
      "initial": "planned",
      "terminal": ["done"],
      "bubble": "done_when_all_children_done"
    }
  }
}
